{
  "mcpServers": {
    "poppydb-local": {
      "command": "/Library/Java/JavaVirtualMachines/<jdk-21>/Contents/Home/bin/java",
      "args": [
        "-jar", "/Users/rentzi/Genios/Claude/poppydb-mcp/dist/poppydb-mcp.jar",
        "--hosts", "localhost:17017",
        "--allow-write"
      ]
    },
    "poppydb-replicaset-readonly": {
      "command": "/Library/Java/JavaVirtualMachines/<jdk-21>/Contents/Home/bin/java",
      "args": [
        "-DsocksProxyHost=localhost", "-DsocksProxyPort=5555",
        "-jar", "/Users/rentzi/Genios/Claude/poppydb-mcp/dist/poppydb-mcp.jar",
        "--uri", "mongodb://host1:17017,host2:17017,host3:17017/test?replicaSet=rs0&authSource=admin",
        "--user", "readonly"
      ],
      "env": {
        "POPPYDB_PASSWORD": "<passwort>"
      }
    }
  }
}
